{
  "_说明": "每个模型的转换配方，由 convert_all.py 读取。路径前缀：dl: 下载目录；split: NLLB 拆图目录；couplet / sdxs: 前处理产物目录；asr: 语音 fp32 模型目录；data: scripts/mnn/data。nllb 的 tokenizer 是 vocab_build.py 产出的 v2 词表；notice / model_json 由 convert_all.py 生成进产物目录。variants.<名>.quant 是 MNNConvert 的量化参数（graph 级可在 quant_by_graph 里覆盖）；所有变体共用 graphs 的输入输出名。",
  "models": {
    "siglip2": {
      "group": "siglip2",
      "display_name": "本地识物模型（SigLIP2）",
      "license": "apache-2.0",
      "release_tag": "siglip2-mnn-v1",
      "default": "w8",
      "graphs": [
        {"name": "model", "input": "dl:siglip2/vision_model.onnx", "output": "model.mnn"}
      ],
      "copy": [],
      "variants": {
        "w8": {"id": "siglip2-mnn-w8", "quant": ["--weightQuantBits", "8"]},
        "w6hqq": {"id": "siglip2-mnn-w6hqq", "quant": ["--weightQuantBits", "6", "--hqq"]},
        "fp32": {"id": "siglip2-mnn-fp32", "quant": []}
      }
    },
    "nllb": {
      "group": "nllb",
      "display_name": "本地翻译模型（NLLB-200 600M，6 语）",
      "license": "cc-by-nc-4.0",
      "release_tag": "nllb-mnn-v1",
      "prepare": "nllb",
      "tokenizer": "dl:nllb-tok-v2/tokenizer.json",
      "default": "w6hqq",
      "graphs": [
        {"name": "encoder", "input": "split:encoder.onnx", "output": "encoder.mnn"},
        {"name": "cross_kv", "input": "split:cross_kv.onnx", "output": "cross_kv.mnn"},
        {"name": "decoder_step", "input": "split:decoder_step.onnx", "output": "decoder_step.mnn"}
      ],
      "common_args": ["--saveExternalData"],
      "copy": ["split:embed.i8", "split:embed.scale", "dl:nllb-tok-v2/tokenizer.json", "data:nllb/LICENSE-CC-BY-NC-4.0.txt"],
      "notice": "data:nllb/NOTICE.txt",
      "model_json": {
        "schema_version": 1,
        "family": "m2m100",
        "format": "mnn-split",
        "files": {
          "encoder": "encoder.mnn", "encoder_data": "encoder.mnn.weight",
          "cross_kv": "cross_kv.mnn", "cross_kv_data": "cross_kv.mnn.weight",
          "decoder": "decoder_step.mnn", "decoder_data": "decoder_step.mnn.weight",
          "embed": "embed.i8", "embed_scale": "embed.scale",
          "tokenizer": "tokenizer.json"
        },
        "languages": ["zh-CN", "en", "fr", "es", "ru", "ar"],
        "lang_tokens": {"zh-CN": "zho_Hans", "en": "eng_Latn", "fr": "fra_Latn", "es": "spa_Latn", "ru": "rus_Cyrl", "ar": "arb_Arab"},
        "max_input_tokens": 512,
        "generation": {
          "decoder_start_token_id": 2, "eos_token_id": 2, "pad_token_id": 1, "bad_token_ids": [],
          "max_new_tokens": 256, "num_beams": 1, "length_penalty": 2.0, "min_length_ratio": 0.7, "no_repeat_ngram_size": 0
        },
        "execution": {"intra_threads": 0, "cpu_arena": true, "mem_pattern": true, "opt_level": 3, "prepacking": true}
      },
      "variants": {
        "w6hqq": {"id": "nllb600m-un6-mnn-w6", "quant": ["--weightQuantBits", "6", "--hqq"],
                  "quant_label": "mnn-w6-hqq", "quant_desc": "MNN 6-bit weight quantization (HQQ, per-channel; the int8 embedding table is separate)",
                  "display_name": "NLLB-200 distilled 600M (UN six languages, MNN 6-bit)"},
        "w8": {"id": "nllb600m-un6-mnn-w8", "quant": ["--weightQuantBits", "8"],
               "quant_label": "mnn-w8", "quant_desc": "MNN 8-bit weight quantization (per-channel; the int8 embedding table is separate)",
               "display_name": "NLLB-200 distilled 600M (UN six languages, MNN 8-bit)"}
      }
    },
    "asr": {
      "group": "asr",
      "display_name": "本地语音输入模型（zipformer 中英）",
      "license": "apache-2.0",
      "release_tag": "asr-mnn-v1",
      "default": "w8",
      "graphs": [
        {"name": "encoder", "input": "asr:encoder.onnx", "output": "encoder.mnn"},
        {"name": "decoder", "input": "asr:decoder.onnx", "output": "decoder.mnn"},
        {"name": "joiner", "input": "asr:joiner.onnx", "output": "joiner.mnn"}
      ],
      "copy": ["asr:tokens.txt"],
      "variants": {
        "w8": {"id": "asr-zipformer-zh-en-mnn-w8", "quant": ["--weightQuantBits", "8"]},
        "w4b32hqq": {"id": "asr-zipformer-zh-en-mnn-w4", "quant": ["--weightQuantBits", "4", "--weightQuantBlock", "32", "--hqq"]},
        "fp32": {"id": "asr-zipformer-zh-en-mnn-fp32", "quant": []}
      }
    },
    "ocr": {
      "group": "ocr",
      "display_name": "本地文字识别模型（PP-OCRv5）",
      "license": "apache-2.0",
      "release_tag": "ocr-mnn-v1",
      "default": "fp16",
      "graphs": [
        {"name": "det", "input": "dl:ocr/ch_PP-OCRv5_det_mobile.onnx", "output": "det.mnn"},
        {"name": "rec", "input": "dl:ocr/ch_PP-OCRv5_rec_mobile.onnx", "output": "rec.mnn"},
        {"name": "cls", "input": "dl:ocr/ch_PP-LCNet_x0_25_textline_ori_cls_mobile.onnx", "output": "cls.mnn"}
      ],
      "copy": ["data:ocr/LICENSE-Apache-2.0.txt", "data:ocr/NOTICE.txt"],
      "ocr_dict": "dl:ocr/ch_PP-OCRv5_rec_mobile.onnx",
      "variants": {
        "fp16": {"id": "ppocrv5-mnn-fp16", "quant": ["--fp16"]},
        "fp32": {"id": "ppocrv5-mnn-fp32", "quant": []},
        "w8": {"id": "ppocrv5-mnn-w8", "quant": ["--weightQuantBits", "8"]}
      }
    },
    "ocr6": {
      "group": "ocr6",
      "display_name": "本地文字识别模型（PP-OCRv6 small）",
      "license": "apache-2.0",
      "release_tag": "ocr-mnn-v2",
      "default": "fp16",
      "graphs": [
        {"name": "det", "input": "dl:ocr6/det/inference.onnx", "output": "det.mnn"},
        {"name": "rec", "input": "dl:ocr6/rec/inference.onnx", "output": "rec.mnn"},
        {"name": "cls", "input": "dl:ocr/ch_PP-LCNet_x0_25_textline_ori_cls_mobile.onnx", "output": "cls.mnn"}
      ],
      "copy": ["data:ocr6/LICENSE-Apache-2.0.txt", "data:ocr6/NOTICE.txt"],
      "ocr_dict_yaml": "dl:ocr6/rec/inference.yml",
      "variants": {
        "fp16": {"id": "ppocrv6-small-mnn-fp16", "quant": ["--fp16"]},
        "fp32": {"id": "ppocrv6-small-mnn-fp32", "quant": []}
      }
    },
    "couplet": {
      "group": "couplet",
      "display_name": "本地对联模型（GPT-2 对联 uer/gpt2-chinese-couplet）",
      "license": "unknown",
      "release_tag": "couplet-gpt2-mnn-v1",
      "prepare": "couplet",
      "default": "w6hqq",
      "graphs": [
        {"name": "model", "input": "couplet:model_e8.onnx", "output": "model.mnn"}
      ],
      "common_args": ["--saveExternalData"],
      "copy": ["dl:couplet/vocab.txt", "dl:couplet/UER-py_LICENSE_Apache-2.0.txt", "dl:couplet/couplet-clean-dataset_LICENSE_MIT.txt"],
      "notice": "data:couplet/NOTICE.txt",
      "model_json": {
        "schema_version": 1,
        "family": "gpt2-couplet",
        "format": "mnn-single",
        "files": {"model": "model.mnn", "model_data": "model.mnn.weight", "vocab": "vocab.txt"},
        "inputs": [
          {"name": "input_ids", "dtype": "int32", "shape": ["1", "seq"]},
          {"name": "position_ids", "dtype": "int32", "shape": ["1", "seq"]}
        ],
        "outputs": [{"name": "logits", "dtype": "float32", "shape": ["1", "1", "21128"], "note": "只含最后一个输入位置的 logits"}],
        "tokenizer": {"type": "bert-char", "vocab_size": 21128, "cls": 101, "sep": 102, "unk": 100, "pad": 0, "dash": 118,
                      "prompt": "[CLS] + 上联逐字 + '-'；不要在末尾加 [SEP]"},
        "generation": {
          "no_kv_cache": true, "recompute_full_sequence": true,
          "equal_length": true, "top_k": 40, "temperature": 0.8, "stop_token_id": 102,
          "max_upper_chars": 14, "max_positions": 64,
          "allowed_output": "汉字；上联对应位是标点则照抄",
          "reject_input": ["英文字母", "数字", "括号"]
        },
        "execution": {"threads": 4, "memory": "low", "precision": "normal"}
      },
      "variants": {
        "w6hqq": {"id": "couplet-gpt2-mnn", "quant": ["--weightQuantBits", "6", "--hqq"],
                  "quant_label": "mnn-w6-hqq", "quant_desc": "MNN 6-bit weight quantization (HQQ, per-channel) of all MatMul weights including lm_head; the token embedding table is stored in-graph as int8 with a per-row scale",
                  "display_name": "GPT-2 Chinese couplet (MNN 6-bit)"},
        "w8": {"id": "couplet-gpt2-mnn-w8", "quant": ["--weightQuantBits", "8", "--weightQuantAsymmetric"],
               "quant_label": "mnn-w8", "quant_desc": "MNN 8-bit asymmetric weight quantization (per-channel) of all MatMul weights including lm_head; the token embedding table is stored in-graph as int8 with a per-row scale",
               "display_name": "GPT-2 Chinese couplet (MNN 8-bit)"},
        "w4b32hqq": {"id": "couplet-gpt2-mnn-w4", "quant": ["--weightQuantBits", "4", "--weightQuantBlock", "32", "--hqq"],
                     "quant_label": "mnn-w4-b32-hqq", "quant_desc": "MNN 4-bit weight quantization (block 32, HQQ) of all MatMul weights including lm_head; the token embedding table is stored in-graph as int8 with a per-row scale",
                     "display_name": "GPT-2 Chinese couplet (MNN 4-bit)"},
        "fp32": {"id": "couplet-gpt2-mnn-fp32", "quant": [],
                 "quant_label": "mnn-fp32", "quant_desc": "no weight quantization (the token embedding table is still stored in-graph as int8 with a per-row scale)",
                 "display_name": "GPT-2 Chinese couplet (MNN fp32 weights)"}
      }
    },
    "sdxs": {
      "group": "sdxs",
      "display_name": "本地符号生成模型（SDXS-512 DreamShaper）",
      "license": "creativeml-openrail-m / openrail++（见随包 NOTICE）",
      "release_tag": "sdxs-mnn-v1",
      "prepare": "sdxs",
      "default": "w8",
      "graphs": [
        {"name": "text_encoder", "input": "sdxs:text_encoder.onnx", "output": "text_encoder.mnn"},
        {"name": "unet", "input": "sdxs:unet.onnx", "output": "unet.mnn"},
        {"name": "vae_decoder", "input": "sdxs:vae_decoder.onnx", "output": "vae_decoder.mnn"}
      ],
      "copy": [
        "sdxs:tokenizer.json",
        "data:sdxs/LICENSE-CreativeML-OpenRAIL-PlusPlus-M.txt",
        "data:sdxs/LICENSE-CreativeML-OpenRAIL-M.txt",
        "data:sdxs/LICENSE-MIT-TAESD.txt",
        "data:sdxs/LICENSE-MIT-OpenAI-CLIP.txt"
      ],
      "notice": "data:sdxs/NOTICE.txt",
      "variants": {
        "w8": {
          "id": "sdxs512-mnn-w8",
          "quant": ["--weightQuantBits", "8"],
          "quant_by_graph": {"vae_decoder": []},
          "quant_label": "mnn-w8",
          "quant_desc": "MNN 8-bit weight quantization for text_encoder and unet; vae_decoder kept as fp32",
          "display_name": "SDXS-512 DreamShaper (MNN 8-bit)"
        },
        "fp32": {
          "id": "sdxs512-mnn-fp32",
          "quant": [],
          "quant_label": "mnn-fp32",
          "quant_desc": "no weight quantization (fp32 weights; desktop peak 5.6GB, for verification only, not for mobile)",
          "display_name": "SDXS-512 DreamShaper (MNN fp32 weights, verification only)"
        }
      }
    }
  }
}
