const __vite_ssr_export_default__ = "import { MAX_CANVAS_PIXELS, MAX_CANVAS_SIDE } from '@/shared/image-calc'\r\n\r\n/** 文本测宽函数：返回字符串在当前字体下的像素宽（实际用 ctx.measureText，测试里可注入） */\r\nexport type Measure = (text: string) => number\r\n\r\n/** 对齐方式 */\r\nexport type TextAlign = 'left' | 'center' | 'right'\r\n\r\n/** 排版参数 */\r\nexport interface LayoutOptions {\r\n  /** 画布宽（像素） */\r\n  width: number\r\n  /** 字号（像素） */\r\n  fontSize: number\r\n  /** 行距倍数，如 1.6 */\r\n  lineHeightRatio: number\r\n  /** 四周内边距（像素） */\r\n  padding: number\r\n  /** 单张最大高度上限，0 表示只受画布上限约束 */\r\n  heightCap: number\r\n  /** 页脚文字，空串表示没有 */\r\n  footer: string\r\n}\r\n\r\n/** 一页（一张图）的排版结果 */\r\nexport interface Page {\r\n  /** 本页的行 */\r\n  lines: string[]\r\n  /** 画布宽 */\r\n  width: number\r\n  /** 画布高 */\r\n  height: number\r\n}\r\n\r\n/** 字符簇类型：空白 / 英文数字等连写字符 / 中日韩及其他需逐字断行的字符 */\r\ntype Kind = 'space' | 'word' | 'cjk'\r\n\r\n/** 一个断行单元 */\r\ninterface Token {\r\n  /** 文本 */\r\n  text: string\r\n  /** 类型 */\r\n  kind: Kind\r\n}\r\n\r\n/** 不能出现在行首的标点（遇到时悬挂在上一行末尾） */\r\nconst NO_LINE_START = '，。、；：！？）》」』】〕”’…—～·％'\r\n/** 不能出现在行尾的标点（遇到时随下一字换到下一行） */\r\nconst NO_LINE_END = '（《「『【〔“‘'\r\n/** 该码点以上的字符按“逐字断行”处理（CJK 部首区起） */\r\nconst CJK_FROM = 0x2e80\r\n/** 零宽连接符 / 变体选择符 / 肤色修饰符范围 */\r\nconst ZWJ = 0x200d\r\nconst VS16 = 0xfe0f\r\nconst SKIN_FROM = 0x1f3fb\r\nconst SKIN_TO = 0x1f3ff\r\n/** Tab 展开成的空格数 */\r\nconst TAB_SPACES = '  '\r\n/** 页脚字号相对正文的比例与下限 */\r\nconst FOOTER_RATIO = 0.6\r\nconst FOOTER_MIN = 12\r\n/** 页脚区上下留白（占页脚字号的倍数） */\r\nconst FOOTER_GAP_RATIO = 2.4\r\n/** 渐变线计算的小数精度 */\r\nconst PRECISION = 1e6\r\n\r\n/** 背景预设 */\r\nexport interface BgPreset {\r\n  /** 名称 */\r\n  name: string\r\n  /** 起始色 */\r\n  c1: string\r\n  /** 结束色，与起始色相同即纯色 */\r\n  c2: string\r\n  /** 建议文字色 */\r\n  text: string\r\n}\r\n\r\n/** 常用背景预设（含配套文字色） */\r\nexport const BG_PRESETS: BgPreset[] = [\r\n  { name: '纸白', c1: '#ffffff', c2: '#ffffff', text: '#222222' },\r\n  { name: '米黄', c1: '#f6efdd', c2: '#f6efdd', text: '#3d3427' },\