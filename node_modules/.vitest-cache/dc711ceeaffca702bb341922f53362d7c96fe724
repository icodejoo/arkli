const __vite_ssr_export_default__ = "// HTTP 状态码中文数据表：释义为自写，依据 RFC 9110 等规范；非标准码单独标注\r\n\r\n/** 一条状态码 */\r\nexport interface StatusEntry {\r\n  /** 状态码 */\r\n  code: number\r\n  /** 中文名 */\r\n  name: string\r\n  /** 英文标准短语 */\r\n  phrase: string\r\n  /** 含义 */\r\n  meaning: string\r\n  /** 常见场景与排查方向 */\r\n  scene: string\r\n  /** 是否非标准码（nginx、Cloudflare 等私有扩展） */\r\n  nonStandard?: boolean\r\n}\r\n\r\n/** 状态码大类的编号与中文名 */\r\nexport const CLASS_LABELS: Record<number, string> = {\r\n  1: '1xx 信息响应',\r\n  2: '2xx 成功',\r\n  3: '3xx 重定向',\r\n  4: '4xx 客户端错误',\r\n  5: '5xx 服务端错误',\r\n}\r\n\r\n/** 全部状态码，按码值升序 */\r\nexport const STATUS_LIST: StatusEntry[] = [\r\n  { code: 100, name: '继续', phrase: 'Continue', meaning: '服务器已收到请求头，客户端可以继续发送请求体。', scene: '上传大文件时客户端带 Expect: 100-continue，先问服务器愿不愿意收。' },\r\n  { code: 101, name: '切换协议', phrase: 'Switching Protocols', meaning: '服务器同意按客户端要求换一种协议通信。', scene: 'WebSocket 握手成功时返回；升级到 HTTP/2 明文时也会见到。' },\r\n  { code: 102, name: '处理中', phrase: 'Processing', meaning: '服务器已收到请求，还在处理，暂时没有结果（WebDAV）。', scene: '处理耗时很长的 WebDAV 操作，防止客户端以为超时。' },\r\n  { code: 103, name: '提前提示', phrase: 'Early Hints', meaning: '在最终响应之前，先把一部分响应头发出来。', scene: '服务器提前通知浏览器预加载 CSS、JS，加快首屏。' },\r\n\r\n  { code: 200, name: '成功', phrase: 'OK', meaning: '请求成功，响应里带着结果。', scene: '最常见的正常响应：GET 拿到内容、POST 处理完成。' },\r\n  { code: 201, name: '已创建', phrase: 'Created', meaning: '请求成功，并且新建了资源。', scene: 'REST 接口 POST 创建记录后返回，Location 头通常指向新资源。' },\r\n  { code: 202, name: '已接受', phrase: 'Accepted', meaning: '请求收到了，但还没处理完，稍后才会处理。', scene: '异步任务、消息队列类接口，先受理再慢慢跑。' },\r\n  { code: 203, name: '非权威信息', phrase: 'Non-Authoritative Information', meaning: '请求成功，但内容经过代理修改，不是源服务器的原样。', scene: '经过转换内容的代理或网关，实际中很少见。' },\r\n  { code: 204, name: '无内容', phrase: 'No Content', meaning: '请求成功，但响应没有正文。', scene: 'DELETE、PUT 成功后不需要返回数据；跨域预检 OPTIONS 也常用。' },\r\n  { code: 205, name: '重置内容', phrase: 'Reset Content', meaning: '请求成功，要求客户端把当前表单或视图重置。', scene: '提交完表单让页面清空输入，实际很少用。' },\r\n  { code: 206, name: '部分内容',