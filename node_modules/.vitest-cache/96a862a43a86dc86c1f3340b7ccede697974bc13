\r\n\r\n/* 每轮成绩 */\r\n.rt-times {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  gap: $space-2;\r\n\r\n  &__item {\r\n    padding: 2px $space-2;\r\n    border-radius: 8px;\r\n    background: var(--c-surface-active);\r\n    color: var(--c-text);\r\n    font-size: 14px;\r\n    font-variant-numeric: tabular-nums;\r\n  }\r\n}\r\n</style>\r\n"
