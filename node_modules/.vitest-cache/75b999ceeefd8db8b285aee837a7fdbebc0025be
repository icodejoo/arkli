/** 造一个正矩形文字块 */
function blk(text, x, y, w = 60, h = 20) {
	return {
		text,
		box: [
			x,
			y,
			x + w,
			y,
			x + w,
			y + h,
			x,
			y + h
		],
		score: .9
	};
}
/** 三列 x 起点 */
const COL_X = [
	0,
	100,
	200
