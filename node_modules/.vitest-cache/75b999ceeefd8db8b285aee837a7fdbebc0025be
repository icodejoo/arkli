/** 按行列文本造一张规整的表 */
function grid(cells, rowGap = 40) {
	const out = [];
	cells.forEach((r, i) => r.forEach((t, j) => t && out.push(blk(t, COL_X[j], i * rowGap))));
	return out;
}
