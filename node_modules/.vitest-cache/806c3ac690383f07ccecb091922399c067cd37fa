const __vite_ssr_export_default__ = "<script setup lang=\"ts\">\r\n// 手电筒：常亮 / SOS / 频闪，用手机后置闪光灯；退出页面或切后台自动关灯\r\nimport { onBeforeUnmount, onMounted, ref } from 'vue'\r\nimport { showToast } from 'vant'\r\nimport { isNativeAvailable } from '@/native/bridge'\r\nimport { setTorch } from '@/native/system'\r\nimport { createToolStorage } from '@/shared/toolStorage'\r\nimport { usePersistedRef } from '@/shared/usePersistedRef'\r\nimport { clampStrobeHz, DEFAULT_STROBE_HZ, MAX_STROBE_HZ, MIN_STROBE_HZ, sosSteps, strobeSteps, type TorchStep } from './logic'\r\n\r\n/** 本工具的持久缓存 */\r\nconst store = createToolStorage('torch')\r\n/** 模式 */\r\ntype Mode = 'steady' | 'sos' | 'strobe'\r\n\r\n/** 模式选项 */\r\nconst MODES: { id: Mode; name: string }[] = [\r\n  { id: 'steady', name: '常亮' },\r\n  { id: 'sos', name: 'SOS' },\r\n  { id: 'strobe', name: '频闪' },\r\n]\r\n/** 频率滑杆步长（Hz） */\r\nconst HZ_STEP = 0.5\r\n/** 无宿主时的提示 */\r\nconst TIP_NO_HOST = '手电筒只能在 Arkli App 里使用。'\r\n/** 没有闪光灯时的提示 */\r\nconst TIP_NO_FLASH = '这台设备没有可用的后置闪光灯。'\r\n/** 调用失败时的提示 */\r\nconst TIP_FAILED = '手电筒打开失败，可能被其他应用占用了相机。'\r\n\r\n/** 当前模式 */\r\nconst mode = usePersistedRef<Mode>(store, 'mode', 'steady', (v) => MODES.some((m) => m.id === v))\r\n/** 频闪频率 */\r\nconst hz = usePersistedRef(store, 'hz', DEFAULT_STROBE_HZ, (v) => typeof v === 'number' && v >= MIN_STROBE_HZ && v <= MAX_STROBE_HZ)\r\n/** 是否在运行（常亮时等同于灯亮） */\r\nconst running = ref(false)\r\n/** 灯当前是否亮着（SOS / 频闪时随节奏变化） */\r\nconst lit = ref(false)\r\n\r\n/** 定时器 id */\r\nlet timer: ReturnType<typeof setTimeout> | null = null\r\n/** 串行化原生调用，保证最后一次是关灯 */\r\nlet chain: Promise<unknown> = Promise.resolve()\r\n/** 运行代数：停止后旧定时器回调直接作废 */\r\nlet generation = 0\r\n\r\n/** 把开关请求排进队列；失败时提示并停止 */\r\nfunction send(on: boolean): void {\r\n  chain = chain.then(async () => {\r\n    try {\r\n      const r = await setTorch(on)\r\n      if (on && !r.available) {\r\n        showToast(TIP_NO_FLASH)\r\n        halt()\r\n      }\r\n    } catch {\r\n      if (on) {\r\n        showTo