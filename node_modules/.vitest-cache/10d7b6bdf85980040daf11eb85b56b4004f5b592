const __vite_ssr_export_default__ = "// 亲戚关系计算器：关系链 -> 称呼。先用改写规则化简，再查称谓表。自写，不依赖第三方库\n\n/** 关系步骤：f 爸爸 m 妈妈 h 丈夫 w 妻子 ob 哥哥 lb 弟弟 os 姐姐 ls 妹妹 s 儿子 d 女儿 */\nexport type Step = 'f' | 'm' | 'h' | 'w' | 'ob' | 'lb' | 'os' | 'ls' | 's' | 'd'\n/** 性别：m 男 f 女 */\nexport type Gender = 'm' | 'f'\n\n/** 关系链最大长度，防止输入过长 */\nexport const MAX_CHAIN = 8\n/** 空关系链的称呼 */\nconst SELF = '自己'\n/** 称谓表键的分隔符 */\nconst SEP = ','\n/** 关系链连接词 */\nconst LINK = '的'\n\n/** 每个步骤对应的口语文本，同时用作界面按钮文字 */\nexport const STEP_LABEL: Record<Step, string> = {\n  f: '爸爸',\n  m: '妈妈',\n  h: '丈夫',\n  w: '妻子',\n  ob: '哥哥',\n  lb: '弟弟',\n  os: '姐姐',\n  ls: '妹妹',\n  s: '儿子',\n  d: '女儿',\n}\n\n/** 界面按钮顺序 */\nexport const STEP_ORDER: Step[] = ['f', 'm', 'ob', 'lb', 'os', 'ls', 'h', 'w', 's', 'd']\n\n/** 每个步骤所指人物的性别 */\nconst STEP_GENDER: Record<Step, Gender> = {\n  f: 'm',\n  m: 'f',\n  h: 'm',\n  w: 'f',\n  ob: 'm',\n  lb: 'm',\n  os: 'f',\n  ls: 'f',\n  s: 'm',\n  d: 'f',\n}\n\n/** 同胞步骤 */\nconst SIBLINGS: Step[] = ['ob', 'lb', 'os', 'ls']\n/** 比自己大的同胞 */\nconst OLDER: Step[] = ['ob', 'os']\n/** 比自己小的同胞 */\nconst YOUNGER: Step[] = ['lb', 'ls']\n/** 配偶步骤 */\nconst SPOUSES: Step[] = ['h', 'w']\n/** 父母步骤 */\nconst PARENTS: Step[] = ['f', 'm']\n/** 子女步骤 */\nconst CHILDREN: Step[] = ['s', 'd']\n\n/** 计算结果：成功带称呼列表，失败带提示 */\nexport type KinshipResult = { ok: true; titles: string[] } | { ok: false; error: string }\n\n/**\n * 称谓表：键是化简后的关系链（逗号连接），值是候选称呼。\n * 年龄不明时列出多个（如堂哥/堂弟）。\n */\nconst TITLES: Record<string, string[]> = {\n  '': [SELF],\n  // 直系与同胞\n  f: ['爸爸'],\n  m: ['妈妈'],\n  h: ['丈夫'],\n  w: ['妻子'],\n  ob: ['哥哥'],\n  lb: ['弟弟'],\n  os: ['姐姐'],\n  ls: ['妹妹'],\n  s: ['儿子'],\n  d: ['女儿'],\n  // 祖辈\n  'f,f': ['爷爷'],\n  'f,m': ['奶奶'],\n  'm,f': ['外公'],\n  'm,m': ['外婆'],\n  'f,f,f': ['曾祖父'],\n  'f,f,m': ['曾祖母'],\n  'f,m,f': ['外曾祖父'],\n  'f,m,m': ['外曾祖母'],\n  'm,f,f': ['外曾祖父'],\n  'm,f,m': ['外曾祖母'],\n  'm,m,f': ['外曾祖父'],\n  'm,m,m': ['外曾祖母'],\n  'f,f,ob': ['伯祖父'],\n  'f,f,lb': ['叔祖父'],\n  'f,f,os': ['姑婆'],\n  'f,f,ls': ['