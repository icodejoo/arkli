\r\n      name: name.trim(),\r\n      alias: alias.split(',').map((s) => s.trim()).filter(Boolean),\r\n      cat,\r\n      tip: tip.trim(),\r\n    })\r\n  }\r\n  return out\r\n}\r\n\r\n/** 全部词条 */\r\nexport const WASTE_ITEMS: WasteItem[] = [\r\n  ...parseLines(RECYCLABLE, 'recyclable'),\r\n  ...parseLines(HAZARDOUS, 'hazardous'),\r\n  ...parseLines(WET, 'wet'),\r\n  ...parseLines(DRY, 'dry'),\r\n]\r\n";

