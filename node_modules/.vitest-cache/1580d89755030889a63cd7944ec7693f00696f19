  <div class=\"sk-swatches\">\n        <button\n          v-for=\"c in BG_PALETTE\"\n          :key=\"c\"\n          type=\"button\"\n          class=\"sk-swatch\"\n          :class=\"{ 'sk-swatch--on': bg === c }\"\n          :style=\"{ background: c }\"\n          :aria-label=\"`背景色 ${c}`\"\n          @click=\"setBg(c)\"\n        />\n      </div>\n    </tool-group>\n\n    <p class=\"tool-hint\">清空不能撤销。画板内容不会自动保存，离开页面就没了。</p>\n\n    <!-- 底部动作栏：画板没有「生成」一步，主操作就是保存为图片 -->\n    <bottom-actions :main-loading=\"saving\" main main-text=\"保存为图片\" :disabled=\"{ main: saving }\" @main=\"exportPng\" />\n  </div>\n</template>\n\n<style lang=\"scss\" scoped>\n/* 画布外框 */\n.sk-wrap {\n  width: 100%;\n  overflow: hidden;\n  border-radius: var(--tool-card-radius);\n  background: var(--c-surface);\n  line-height: 0;\n}\n\n/* 画布：禁掉浏览器手势，否则触摸会被当成滚动 */\n.sk-canvas {\n  display: block;\n  touch-action: none;\n  user-select: none;\n  -webkit-user-select: none;\n}\n\n/* 卡片内小标题与上方留距 */\n.sk-title {\n  margin-top: $space-3;\n}\n\n/* 色块排布 */\n.sk-swatches {\n  display: flex;\n  flex-wrap: wrap;\n  gap: $space-3;\n}\n\n/* 单个色块 */\n.sk-swatch {\n  width: 32px;\n  height: 32px;\n  padding: 0;\n  border: 1px solid var(--c-text-muted);\n  border-radius: 50%;\n  cursor: pointer;\n\n  &--on {\n    outline: 2px solid var(--c-primary);\n    outline-offset: 2px;\n  }\n}\n</style>\n"
