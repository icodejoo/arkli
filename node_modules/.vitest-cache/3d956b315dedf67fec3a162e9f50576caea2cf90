  cons: ['不爱争，常把想法憋在心里', '对长远规划不太上心'],\r\n  },\r\n  {\r\n    code: 'INTJ',\r\n    name: '远谋者',\r\n    desc: '独立、有主见，习惯在脑中推演长远的蓝图。你重视能力与效率，不太在意场面上的客套，一旦认定目标，就会安静而坚定地推进下去。',\r\n    pros: ['有远见，善于系统性思考', '自驱力强，标准高'],\r\n    cons: ['不善寒暄，易被看作冷漠', '对自己和别人都要求偏严'],\r\n  },\r\n  {\r\n    code: 'INTP',\r\n    name: '解谜客',\r\n    desc: '好奇心极重，喜欢把原理一层层拆开弄明白。你常沉浸在自己的想法里，愿意为一个有趣的问题熬很久，却不太热衷把结论讲给别人听。',\r\n    pros: ['分析力强，善于抽象思考', '包容不同观点，不爱争输赢'],\r\n    cons: ['想得多做得少，容易拖延', '生活琐事常被忽略'],\r\n  },\r\n  {\r\n    code: 'INFJ',\r\n    name: '听潮人',\r\n    desc: '安静而敏锐，常能察觉别人没说出口的情绪。你心里有一套看重的价值，会为它默默坚持，喜欢有意义的深聊，不太爱无谓的热闹，也懂得独处充电。',\r\n    pros: ['洞察力强，善解人意', '有理想，愿意长期投入'],\r\n    cons: ['容易把心事藏起来，自己消化', '对人对事要求完美，易疲惫'],\r\n  },\r\n  {\r\n    code: 'INFP',\r\n    name: '筑梦人',\r\n    desc: '内心世界丰富，重视真诚与意义。你对理想中的样子很执着，愿意为在意的人和事付出，只是面对现实琐事时，常常需要多给自己一点启动的时间。',\r\n    pros: ['真诚善良，富有想象力', '忠于内心，不随波逐流'],\r\n    cons: ['容易自我怀疑、想太多', '面对冲突和现实压力时容易退缩'],\r\n  },\r\n]\r\n";

