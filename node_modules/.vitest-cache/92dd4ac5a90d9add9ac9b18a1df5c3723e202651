const __vite_ssr_export_default__ = "<script setup lang=\"ts\">\r\n// 模型下载地址面板：列出文件名、大小、sha256、全部镜像地址与 release 页面，可打开可复制，并说明手动放置方式。只在 AI 中心使用。\r\nimport { computed, ref, watch } from 'vue'\r\nimport { showToast } from 'vant'\r\nimport { modelSources, type ModelSources } from '@/native/model'\r\nimport { copyText } from './clipboard'\r\nimport { formatBytes } from './image-calc'\r\nimport { MANUAL_DIR_HINT, MANUAL_STEPS, MANUAL_STEPS_PACKAGE, allFirstUrls, downloadingText, fileCopyText, footerOf, isSinglePackage, manualDirText, openLink } from './modelSources'\r\nimport type { ModelStateName } from '@/native/model'\r\nimport { useAiProviders } from '@/native/useAiProviders'\r\nimport ModelParamsPanel from './ModelParamsPanel.vue'\r\nimport { paramProvidersOf } from './modelParams'\r\n\r\n/** 面板是否显示（v-model） */\r\nconst show = defineModel<boolean>({ required: true })\r\n/** 要看的模型 id、展示名、当前状态（决定底部按钮）与下载进度 0~1（只用于下载中的按钮文字） */\r\nconst props = defineProps<{ modelId: string; modelName: string; state: ModelStateName; progress?: number }>()\r\n/** 底部按钮事件：下载、删除、校验（由 AI 中心页执行） */\r\nconst emit = defineEmits<{ download: []; remove: []; verify: [] }>()\r\n\r\n/** 是否“一个包”的新格式 */\r\nconst pkg = computed(() => (data.value && isSinglePackage(data.value) ? data.value : null))\r\n\r\n/** 当前底部按钮布局 */\r\nconst footer = computed(() => footerOf(props.state))\r\n\r\n/** 提供者探测（用于按 provider.modelId 关联可调参数） */\r\nconst ai = useAiProviders()\r\n/** 已安装时才展示参数区；没有声明 params 的提供者（语音识别、数据包等）不渲染 */\r\nconst paramProviders = computed(() => (footer.value.primary === 'remove' ? paramProvidersOf(ai.providers.value, props.modelId) : []))\r\n\r\n/** 来源数据，未取到为 null */\r\nconst data = ref<ModelSources | null>(null)\r\n/** 取不到时的提示 */\r\nconst failed = ref('')\r\n\r\n/** 参数区默认标题 */\r\nconst PARAMS_TITLE = '参数调整'\r\n\r\n/** 没有原生宿主或读取失败的提示 */\r\nconst MSG_UNAVAILABLE = '暂时读不到下载地址（需要在 App 内打开）'\r\n\r\n/** 打开面板时读一次来源（一次性读取，不轮询） */\r\nwatch(show, async (v) => {\r\n  if (!v) return\r\n  void ai.ensure()\r\n  data.