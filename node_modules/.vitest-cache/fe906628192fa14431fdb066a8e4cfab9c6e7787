\r\n}\r\n\r\n/* 摘要紧贴列表 */\r\n.fc-summary {\r\n  margin: 0 0 $space-2;\r\n}\r\n\r\n/* 全选靠右 */\r\n.fc-all {\r\n  margin-left: auto;\r\n}\r\n\r\n/* 结果列表上方留白 */\r\n.fc-list {\r\n  margin: $space-2 0;\r\n}\r\n\r\n/* 文件名一行省略 */\r\n.fc-name {\r\n  overflow: hidden;\r\n  text-overflow: ellipsis;\r\n  white-space: nowrap;\r\n  color: var(--c-text);\r\n}\r\n\r\n/* 相对路径 */\r\n.fc-path {\r\n  overflow: hidden;\r\n  text-overflow: ellipsis;\r\n  white-space: nowrap;\r\n}\r\n\r\n/* 大小与时间 */\r\n.fc-meta {\r\n  margin-top: 2px;\r\n}\r\n\r\n/* 红字警示 */\r\n.fc-danger {\r\n  color: var(--c-error);\r\n}\r\n\r\n/* 已选合计 */\r\n.fc-total {\r\n  margin: $space-3 0 0;\r\n  font-size: 14px;\r\n  color: var(--c-text);\r\n}\r\n</style>\r\n"
