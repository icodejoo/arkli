const __vite_ssr_export_default__ = "<script setup lang=\"ts\">\n// 图片压缩（含格式转换）：JPEG / WebP / PNG，质量、最长边、目标体积、PNG 缩色。\n// App 内走原生 native.image.compress；桌面浏览器没有宿主时退回 Canvas，两条路径共用界面与结果列表。\nimport BottomActions from '@/shared/BottomActions.vue'\nimport { computed, onBeforeUnmount, reactive, ref, shallowRef, watch } from 'vue'\nimport { showFailToast, showSuccessToast, showToast } from 'vant'\nimport ImageThumbList from '@/shared/ImageThumbList.vue'\nimport CellPicker from '@/shared/CellPicker.vue'\nimport { createToolStorage } from '@/shared/toolStorage'\nimport type { CellOption } from '@/shared/cellPicker'\nimport { shootPhoto } from '@/shared/shootPhoto'\nimport { changeText, fitMaxEdge, FORMAT_MIME, formatBytes, outputName } from '@/shared/image-calc'\nimport {\n  canvasToBlob,\n  drawScaled,\n  loadBitmap,\n  pickImages,\n  releaseCanvas,\n  saveBlobs,\n  webpEncodeSupported,\n  type PickedImage,\n} from '@/shared/image-io'\nimport { isNativeAvailable } from '@/native/bridge'\nimport { useNative } from '@/native/useNative'\nimport {\n  buildParams,\n  type CompressFormat,\n  type PngMode,\n  capabilities,\n  COLORS_MAX,\n  COLORS_MIN,\n  describeFailed,\n  EDGE_PRESETS,\n  isBigger,\n  PALETTE_HINT,\n  progressText,\n  sanitizeOptions,\n  QUALITY_MAX,\n  QUALITY_MIN,\n  resultNote,\n  roomLeft,\n  type NativeFailed,\n  type NativeItem,\n} from './logic'\n\n/** 单次最多选择张数 */\nconst MAX_PICK = 20\n/** 输出文件名后缀（Canvas 路径用） */\nconst NAME_SUFFIX = '-min'\n/** 缓存路径在页面里的同源前缀 */\nconst FILES_URL_PREFIX = '/files/'\n/** 取消错误码 */\nconst CODE_CANCELLED = 'CANCELLED'\n/** JPEG 透明区底色 */\nconst JPEG_FILL = '#ffffff'\n\n/** 一条结果（原生与 Canvas 共用） */\ninterface Row {\n  /** 列表 key */\n  id: number\n  /** 保存名 */\n  name: string\n  /** 缩略图地址 */\n  url: string\n  /** 宽 */\n  width: number\n  /** 高 */\n  height: number\n  /** 成品字节数 */\n  bytes: number\n  /** 原图字节数 */\n  srcBytes: number\n  /** MIME */\n  mime: string\n  /** 说明文案 */\n  note: string\n  /** 是否比原图大 */\n  bigger: boolean\n  /** 原生缓存路径（原生路径） */\n  path?: string\n  /** 内容（Canvas 路径） */\n  blob?: Blob\n}\n\n/** 是否有原生宿主 */\nconst native = isNativeAvailable()\n/** 原生调用、事件与取消 */\nconst { call, on, cancelAll } = useNative()\n/** 已选图片 */\nconst images = ref<PickedImage[]>([])\n/** 最长边选项：0 表示不限 */\nconst EDGE_OPTIONS = EDGE_PRESETS.map((e) => ({ value: e, label: e ? String(e) : '不限' }))\n/** 持久缓存 */\nconst store = createToolStorage('image-compress')\n/** 选项缓存键 */\nconst OPTS_KEY = 'opts'\n/** 当前 WebView 能否编码 WebP（原生路径恒可） */\nconst webpOk = native || webpEncodeSupported()\n/** 选项（读缓存回填，目标体积除外） */\nconst opts = reactive(sanitizeOptions(store.get<unknown>(OPTS_KEY, null), webpOk))\n// 选项变化即落盘；目标体积是输入框内容，不存\nwatch(opts, ({ targetKb: _omit, ...rest }) => void store.set(OPTS_KEY, rest), { deep: true })\n/** 输出格式选项；WebP 在不支持编码时禁用 */\nconst FORMAT_OPTIONS = computed<CellOption[]>(() => [\n  { value: 'jpeg', label: 'JPEG' },\n  { value: 'webp', label: 'WebP', disabled: !webpOk },\n  { value: 'png', label: 'PNG' },\n])\n/** PNG 模式选项；缩色在无原生能力时禁用 */\nconst PNG_MODE_OPTIONS = computed<CellOption[]>(() => [\n  { value: 'lossless', label: '无损' },\n  { value: 'palette', label: '缩色', disabled: !caps.value.pngPalette },\n])\n/** 结果 */\nconst rows = shallowRef<Row[]>([])\n/** 失败项 */\nconst failed = ref<string[]>([])\n/** 是否处理中 */\nconst busy = ref(false)\n/** 是否保存中 */\nconst saving = ref(false)\n/** 进度文案 */\nconst progress = ref('')\n/** Canvas 路径的取消标记 */\nlet cancelled = false\n/** 自增编号 */\nlet seq = 0\n\n/** 当前选项下的可用能力 */\nconst caps = computed(() => capabilities(native, opts.format))\n/** 是否显示 PNG 缩色提示 */\nconst showPaletteHint = computed(() => opts.format === 'png' && opts.pngMode === 'palette')\n/** 前后总体积对比 */\nconst summary = computed(() => {\n  if (!rows.value.length) return ''\n  const before = rows.value.reduce((s, r) => s + r.srcBytes, 0)\n  const after = rows.value.reduce((s, r) => s + r.bytes, 0)\n  return `${formatBytes(before)} → ${formatBytes(after)}（${changeText(before, after)}）`\n})\n/** 颜色数滑杆值（v