s=\"pm-reset\" plain block type=\"danger\" size=\"small\" @click=\"onResetAll\">全部重置</van-button>\r\n    </tool-group>\r\n    <p class=\"tool-hint\">每个阶段结束时用系统闹钟提醒，退到后台或锁屏也会响。设备重启后提醒会失效。</p>\r\n\r\n    <!-- 底部动作栏：主按钮开始 / 继续 / 暂停 -->\r\n    <bottom-actions :main-loading=\"st.status === 'running'\" main :main-text=\"st.status === 'running' ? '暂停' : st.status === 'paused' ? '继续' : '开始'\" :main-type=\"st.status === 'running' ? 'warning' : 'primary'\" @main=\"st.status === 'running' ? onPause() : onStart()\" />\r\n  </div>\r\n</template>\r\n\r\n<style lang=\"scss\" scoped>\r\n/* 计时卡片：内容居中 */\r\n.pm-clock {\r\n  display: flex;\r\n  flex-direction: column;\r\n  align-items: center;\r\n  gap: $space-3;\r\n}\r\n\r\n/* 进度环容器，数字叠在环中央 */\r\n.pm-ring {\r\n  position: relative;\r\n  width: 220px;\r\n  height: 220px;\r\n}\r\n\r\n/* 环从 12 点方向开始 */\r\n.pm-ring__svg {\r\n  width: 100%;\r\n  height: 100%;\r\n  transform: rotate(-90deg);\r\n}\r\n\r\n/* 环底色 */\r\n.pm-ring__bg {\r\n  fill: none;\r\n  stroke: var(--c-border);\r\n  stroke-width: 10;\r\n}\r\n\r\n/* 已走过的部分 */\r\n.pm-ring__fg {\r\n  fill: none;\r\n  stroke-width: 10;\r\n  stroke-linecap: round;\r\n}\r\n\r\n/* 倒计时数字 */\r\n.pm-time {\r\n  position: absolute;\r\n  inset: 0;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  font-size: 48px;\r\n  font-weight: 700;\r\n  font-variant-numeric: tabular-nums;\r\n  color: var(--c-text);\r\n}\r\n\r\n/* 轮次小圆点 */\r\n.pm-dots {\r\n  display: flex;\r\n  gap: $space-2;\r\n}\r\n\r\n.pm-dot {\r\n  width: 10px;\r\n  height: 10px;\r\n  border-radius: 50%;\r\n  background: var(--c-border);\r\n\r\n  &--on {\r\n    background: var(--c-primary);\r\n  }\r\n}\r\n\r\n/* 操作按钮一排 */\r\n.pm-actions {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  justify-content: center;\r\n  gap: $space-2;\r\n}\r\n\r\n/* 全部重置与上方留距 */\r\n.pm-reset {\r\n  margin-top: $space-3;\r\n}\r\n</style>\r\n"
