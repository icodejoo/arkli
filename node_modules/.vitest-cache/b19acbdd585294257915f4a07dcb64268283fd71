const __vite_ssr_export_default__ = "// 噪音测量：等级划分、校准偏移、统计、环形缓冲与折线坐标（纯逻辑）。分贝值是未校准的近似值，仅供参考\r\nimport { createToolStorage, type StorageLike, type ToolStorage } from '@/shared/toolStorage'\r\n\r\n/** 噪音等级的色调，页面据此取颜色 */\r\nexport type Tone = 'ok' | 'warn' | 'bad'\r\n\r\n/** 「很安静」的上界（不含） */\r\nexport const LEVEL_QUIET_MAX = 30\r\n/** 「安静」的上界（不含） */\r\nexport const LEVEL_CALM_MAX = 50\r\n/** 「一般」的上界（不含） */\r\nexport const LEVEL_NORMAL_MAX = 70\r\n/** 「嘈杂」的上界（含）；超过即「有害听力」 */\r\nexport const LEVEL_LOUD_MAX = 85\r\n\r\n/** 校准偏移的范围（dB） */\r\nexport const OFFSET_RANGE = { min: -20, max: 20 } as const\r\n/** 显示分贝的上下限 */\r\nexport const DB_RANGE = { min: 0, max: 140 } as const\r\n/** 表盘与折线图的显示范围（dB），常见环境噪音都落在这里面 */\r\nexport const GAUGE_RANGE = { min: 20, max: 120 } as const\r\n/** 折线图保留的时长（毫秒） */\r\nexport const CHART_WINDOW_MS = 60_000\r\n/** 持久缓存命名空间 */\r\nexport const STORE_NS = 'noise-meter'\r\n/** 校准偏移的存储键 */\r\nexport const OFFSET_KEY = 'offset'\r\n/** 旧版校准偏移的完整存储键 */\r\nexport const LEGACY_OFFSET_KEY = 'arkli.noise-meter.offset'\r\n/** 推送间隔（毫秒） */\r\nexport const SAMPLE_INTERVAL_MS = 100\r\n\r\n/** 等级描述 */\r\nexport interface NoiseLevel {\r\n  /** 中文描述 */\r\n  label: string\r\n  /** 色调 */\r\n  tone: Tone\r\n}\r\n\r\n/**\r\n * 按分贝取等级：<30 很安静、30~50 安静、50~70 一般、70~85 嘈杂、>85 有害听力。\r\n *\r\n * @param db 分贝值\r\n * @returns 等级描述与色调\r\n * @example noiseLevel(60) // { label: '一般', tone: 'ok' }\r\n */\r\nexport function noiseLevel(db: number): NoiseLevel {\r\n  if (db < LEVEL_QUIET_MAX) return { label: '很安静', tone: 'ok' }\r\n  if (db < LEVEL_CALM_MAX) return { label: '安静', tone: 'ok' }\r\n  if (db < LEVEL_NORMAL_MAX) return { label: '一般', tone: 'ok' }\r\n  if (db <= LEVEL_LOUD_MAX) return { label: '嘈杂', tone: 'warn' }\r\n  return { label: '有害听力', tone: 'bad' }\r\n}\r\n\r\n/**\r\n * 把校准偏移夹到 ±20 并取整到 0.5 dB。\r\n *\r\n * @param v 原始偏移\r\n * @returns 合法偏移；非数字返回 0\r\n */\r\nexport function clampOffset(v: number): number {\r\n  if (!Number.isFinite(v)) return 0\r\n  return Math.min(OFFSET_RANGE.max, Math.max(OFFSET_RANGE.min, Math.round(v * 2) / 2))\r\n}\r\n\r\n/**\r\n * 叠加校准偏移并夹到 0~140。\r\n *\r\n * @param db 原生给的近似声压级\r\n * @param offset 校准偏移（dB）\r\n * @returns 显示用分贝\r\n */\r\nexport function applyOffset(db: number, offset: number): number {\r\n  return Math.min(DB_RANGE.max, Math.max(DB_RANGE.min, db + offset))\r\n}\r\n\r\n/**\r\n * 创建噪音测量的持久缓存，并迁移旧版校准偏移。\r\n *\r\n * @param backend 存储后端，缺省 localStorage（测试可注入）\r\n * @returns 持久缓存实例\r\n */\r\nexport function createNoiseStore(backend?: StorageLike | null): ToolStorage {\r\n  const store = createToolStorage(STORE_NS, backend)\r\n  store.adoptLegacy(LEGACY_OFFSET_KEY, OFFSET_KEY, (raw) => clampOffset(Number(raw)))\r\n  return store\r\n}\r\n\r\n/**\r\n * 读取保存的校准偏移。\r\n *\r\n * @param store 持久缓存\r\n * @returns 偏移（dB），读不到或不是数字返回 0\r\n */\r\nexport function loadOffset(store: ToolStorage): number {\r\n  const v = store.get<unknown>(OFFSET_KEY, 0)\r\n  return typeof v === 'number' ? clampOffset(v) : 0\r\n}\r\n\r\n/**\r\n * 保存校准偏移，存储不可用时静默忽略。\r\n *\r\n * @param offset 偏移（dB）\r\n * @param store 持久缓存\r\n */\r\nexport function saveOffset(offset: number, store: ToolStorage): void {\r\n  store.set(OFFSET_KEY, clampOffset(offset))\r\n}\r\n\r\n/**\r\n * 分贝值转表盘比例。\r\n *\r\n * @param db 分贝值\r\n * @returns 0~1，按 20~120 dB 线性映射\r\n */\r\nexport function gaugeFraction(db: number): number {\r\n  const f = (db - GAUGE_RANGE.min) / (GAUGE_RANGE.max - GAUGE_RANGE.min)\r\n  return Math.min(1, Math.max(0, f))\r\n}\r\n\r\n/**\r\n * 折线图要保留的点数。\r\n *\r\n * @param intervalMs 推送间隔（毫秒）\r\n * @param windowMs 时间窗，缺省 60 秒\r\n * @returns 点数，至少 1\r\n */\r\nexport function ringCapacity(intervalMs: number, windowMs = CHART_WINDOW_MS): number {\r\n  return Math.max(1, Math.ceil(windowMs / Math.max(1, intervalMs)))\r\n}\r\n\r\n/**\r\n * 定长环形缓冲：满了就覆盖最旧的，不做数组搬移。\r\n *\r\n * 使用示例：`const r = new RingBuffer(600); r.push(42); r.values()`\r\n */\r\nexport class RingBuffer {\r\n  /** 底层存储 */\r\n  private readonly buf: number[]\r\n  /** 下一次写入位置 */\r\n  private head = 0\r\n  /** 当前元素数 */\r\n  private count = 0\r\n\r\n  /**\r\n   * @param capacity 容量，至少 1\r\n   */\r\n  constructor(readonly capacity: number) {\r\n    this.buf = new Array<number>(Math.max(1, Math.floor(capacity))).fill(0)\r\n  }\r\n\r\n  /** 当前元素数 */\r\n  get size(): number {\r\n    return this.count\r\n  }\r\n\r\n  /**\r\n   * 追加一个值。\r\n   *\r\n   * @param v 值\r\n   */\r\n  push(v: number): void {\r\n    this.buf[this.head] = v\r\n    this.head = (this.head + 1) % this.buf.length\r\n    if (this.count < this.buf.length) this.count++\r\n  }\r\n\r\n  /**\r\n   * 按时间从旧到新取出全部元素。\r\n   *\r\n   * @returns 新数组\r\n   */\r\n  values(): number[] {\r\n    const n = this.buf.length\r\n    const start = this.count < n ? 0 : this.head\r\n    const out: number[] = []\r\n    for (let i = 0; i < this.count; i++) out.push(this.buf[(start + i) % n])\r\n    return out\r\n  }\r\n\r\n  /** 清空 */\r\n  clear(): void {\r\n    this.head = 0\r\n    this.count = 0\r\n  }\r\n}\r\n\r\n/** 最大 / 最小 / 平均的统计结果；还没数据时各项为 null */\r\nexport interface NoiseStatsView {\r\n  /** 最小值 */\r\n  min: number | null\r\n  /** 最大值 */\r\n  max: number | null\r\n  /** 平均值 */\r\n  avg: number | null\r\n  /** 样本数 */\r\n  count: number\r\n}\r\n\r\n/**\r\n * 累计最大 / 最小 / 平均，只记常数个数字，不保存历史。\r\n *\r\n * 使用示例：`const s = new StatsTracker(); s.add(40); s.view()`\r\n */\r\nexport class StatsTracker {\r\n  /** 最小值 */\r\n  private min = Infinity\r\n  /** 最大值 */\r\n  private max = -Infinity\r\n  /** 累加和 */\r\n  private sum = 0\r\n  /** 样本数 */\r\n  private n = 0\r\n\r\n  /**\r\n   * 加入一个样本。\r\n   *\r\n   * @param v 分贝值\r\n   */\r\n  add(v: number): void {\r\n    if (v < this.min) this.min = v\r\n    if (v > this.max) this.max = v\r\n    this.sum += v\r\n    this.n++\r\n  }\r\n\r\n  /**\r\n   * 当前统计。\r\n   *\r\n   * @returns 最小、最大、平均与样本数\r\n   */\r\n  view(): NoiseStatsView {\r\n    if (this.n === 0) return { min: null, max: null, avg: null, count: 0 }\r\n    return { min: this.min, max: this.max, avg: this.sum / this.n, count: this.n }\r\n  }\r\n\r\n  /** 清零 */\r\n  reset(): void {\r\n    this.min = Infinity\r\n    this.max = -Infinity\r\n    this.sum = 0\r\n    this.n = 0\r\n  }\r\n}\r\n\r\n/**\r\n * 分贝显示文字，保留 1 位小数。\r\n *\r\n * @param db 分贝值，null 表示没有数据\r\n * @returns 如 `45.3`；null 返回 `--`\r\n */\r\nexport function formatDb(db: number | null): string {\r\n  return db == null || !Number.isFinite(db) ? '--' : db.toFixed(1)\r\n}\r\n\r\n/**\r\n * 把一串分贝值换算成折线图的画布坐标，右端对齐当前时刻、越旧越靠左。\r\n *\r\n * @param values 从旧到新的分贝值\r\n * @param capacity 满屏对应的点数（右端为最新点）\r\n * @param width 画布宽\r\n * @param height 画布高\r\n * @returns 坐标点 [x, y]，y 向下；超出 20~120 dB 的值贴边\r\n */\r\nexport function chartPoints(values: number[], capacity: number, width: number, height: number): Array<[number, number]> {\r\n  const step = capacity > 1 ? width / (capacity - 1) : 0\r\n  const offset = capacity - values.length\r\n  return values.map((v, i) => [(offset + i) * step, height * (1 - gaugeFraction(v))])\r\n}\r\n\r\n/** 暂停闸的依赖 */\r\nexport interface PauseGateDeps {\r\n  /** 当前是否正在测量 */\r\n  isActive: () => boolean\r\n  /** 暂停时执行：取消订阅、停采样、释放麦克风 */\r\n  suspend: () => void | Promise<void>\r\n  /** 恢复时执行：重新订阅并启动采样 */\r\n  restore: () => void | Promise<void>\r\n}\r\n\r\n/** 暂停闸：把“浮起时停、取回时按原状态恢复”串行化 */\r\nexport interface PauseGate {\r\n  /** 浮起暂停：测量中则记下并 suspend；重复调用无副作用 */\r\n  pause(): void\r\n  /** 取回恢复：仅当暂停前在测量才 restore；重复调用无副作用 */\r\n  resume(): void\r\n  /** 是否处于暂停中（启动流程的异步回调据此放弃启动） */\r\n  readonly suspended: boolean\r\n  /** 暂停期间用户的启动流程做到一半：记下，取回时补启动 */\r\n  deferStart(): void\r\n}\r\n\r\n/**\r\n * 创建暂停闸。suspend 与 restore 排成一条链依次执行，避免“还没停完就又启动”。\r\n *\r\n * @param deps 依赖：是否测量中、暂停动作、恢复动作\r\n * @returns 暂停闸\r\n * @example\r\n * const gate = createPauseGate({ isActive, suspend, restore })\r\n * useFloatPause({ pause: gate.pause, resume: gate.resume })\r\n */\r\nexport function createPauseGate(deps: PauseGateDeps): PauseGate {\r\n  let suspended = false\r\n  let wasActive = false\r\n  let chain: Promise<void> = Promise.resolve()\r\n  /** 把动作接到链尾，出错不阻塞后续 */\r\n  const enqueue = (fn: () => void | Promise<void>): void => {\r\n    chain = chain.then(fn).catch(() => undefined)\r\n  }\r\n  return {\r\n    get suspended() {\r\n      return suspended\r\n    },\r\n    pause() {\r\n      if (suspended) return\r\n      suspended = true\r\n      wasActive = deps.isActive()\r\n      if (wasActive) enqueue(deps.suspend)\r\n    },\r\n    resume() {\r\n      if (!suspended) return\r\n      suspended = false\r\n      if (!wasActive) return\r\n      wasActive = false\r\n      enqueue(deps.restore)\r\n    },\r\n    deferStart() {\r\n      wasActive = true\r\n    },\r\n  }\r\n}\r\n";

