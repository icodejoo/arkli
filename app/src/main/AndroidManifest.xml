<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 仅 API 24~28 保存到公共目录时需要，29+ 走 MediaStore 不要权限 -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- 自带多选图片页读相册：API 33+ 用细分的图片权限，32 及以下用旧存储权限 -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- 联网：页面出站只放行 NetPolicy 白名单，原生联网后续接入 -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- 震动（普通权限，安装即授予） -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- 读网络类型（普通权限，安装即授予） -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- 通知权限：API 33+ 才需要运行时申请，供 native.permission 查询/申请 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 闹钟/提醒：Android 12+ 设精确闹钟需要 -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!-- 噪音测量：麦克风，运行时申请；麦克风不设为必需硬件，没有的设备也能安装 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <!-- 二维码扫码：相机，运行时申请；相机与自动对焦不设为必需硬件，没有的设备也能安装 -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <!-- 包可见性：应用管理只能看到可启动应用（不申请 QUERY_ALL_PACKAGES）；TTS_SERVICE 让系统语音引擎在 API 30+ 可被绑定 -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT" />
            <data android:mimeType="text/plain" />
        </intent>
    </queries>

    <application
        android:networkSecurityConfig="@xml/network_security_config"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Arkli">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- 原生启动动画：透明主题盖在 MainActivity 上，MainActivity 在下面预热 WebView -->
        <activity
            android:name=".splash.SplashActivity"
            android:exported="false"
            android:theme="@style/Theme.Arkli.Splash"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout|uiMode" />
        <!-- 自带多选图片页，仅应用内部拉起 -->
        <activity
            android:name=".picker.ImagePickerActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout|uiMode" />
        <!-- 二维码全屏扫码页，仅应用内部拉起 -->
        <activity
            android:name=".qrcode.QrScanActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout|uiMode" />
        <!-- 原生全屏图片预览，仅应用内部拉起 -->
        <activity
            android:name=".preview.ImagePreviewActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout|uiMode" />
        <!-- 系统分享用：只暴露缓存 arkli/out/ 下的成品文件 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
        <!-- 闹钟到点接收器，仅系统按 PendingIntent 回调；重启后闹钟失效，不做开机恢复 -->
        <receiver
            android:name=".alarm.AlarmReceiver"
            android:exported="false" />
        <!-- spike：WebMessageListener 验证用，结论出来后由主会话决定去留 -->
        <activity
            android:name=".spike.SpikeActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout|uiMode" />
    </application>
</manifest>
